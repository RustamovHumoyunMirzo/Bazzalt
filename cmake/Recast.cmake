include_guard(GLOBAL)
set(BAZZALT_RECAST_DIR "${CMAKE_CURRENT_LIST_DIR}/../deps/recast" CACHE PATH "Pinned private Recast/Detour sources")
if(NOT EXISTS "${BAZZALT_RECAST_DIR}/Recast/Include/Recast.h")
    message(FATAL_ERROR "Recast sources are missing. Run scripts/get_recast.py")
endif()
# Compile only the small runtime libraries, with no demo, examples or dependency tests.
foreach(_part Recast Detour DetourCrowd DetourTileCache)
    file(GLOB _sources CONFIGURE_DEPENDS "${BAZZALT_RECAST_DIR}/${_part}/Source/*.cpp")
    add_library(Bazzalt${_part} STATIC ${_sources})
    target_include_directories(Bazzalt${_part} PUBLIC "${BAZZALT_RECAST_DIR}/${_part}/Include")
    target_compile_definitions(Bazzalt${_part} PUBLIC DT_POLYREF64)
    set_target_properties(Bazzalt${_part} PROPERTIES POSITION_INDEPENDENT_CODE ON)
endforeach()
target_link_libraries(BazzaltDetourCrowd PUBLIC BazzaltDetour)
target_link_libraries(BazzaltDetourTileCache PUBLIC BazzaltDetour)
