include_guard(GLOBAL)
# Jolt is private to the sibling physics module; it never links into core.
option(BAZZALT_BUILD_JOLT "Build the private Jolt physics dependency" ON)
set(BAZZALT_JOLT_LIBRARY "" CACHE FILEPATH "Matching prebuilt Release Jolt library (optional; avoids rebuilding dependency)")
set(BAZZALT_JOLT_DIR "${CMAKE_CURRENT_LIST_DIR}/../deps/jolt" CACHE PATH "Pinned Jolt source tree")
if(NOT BAZZALT_BUILD_JOLT)
    return()
endif()
if(CMAKE_VERSION VERSION_LESS 3.20)
    message(FATAL_ERROR "Jolt requires CMake 3.20 or later.")
endif()
if(NOT CMAKE_SYSTEM_NAME MATCHES "^(Windows|Linux)$")
    message(FATAL_ERROR "BAZZALT physics currently targets Windows/Linux only.")
endif()
if(NOT EXISTS "${BAZZALT_JOLT_DIR}/Build/CMakeLists.txt")
    message(FATAL_ERROR "Jolt source is missing. Run scripts/get_jolt.ps1 or scripts/get_jolt.sh. No automatic download is performed.")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/../scripts/dependencies/jolt.json" _jolt_lock)
string(JSON _jolt_commit GET "${_jolt_lock}" commit)
find_package(Git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${BAZZALT_JOLT_DIR}" rev-parse HEAD
    OUTPUT_VARIABLE _jolt_actual OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _jolt_status)
if(NOT _jolt_status EQUAL 0 OR NOT _jolt_actual STREQUAL _jolt_commit)
    message(FATAL_ERROR "Jolt source does not match scripts/dependencies/jolt.json. Use the pinned source getter.")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${BAZZALT_JOLT_DIR}" status --porcelain --untracked-files=normal
    OUTPUT_VARIABLE _jolt_changes RESULT_VARIABLE _jolt_status)
if(NOT _jolt_status EQUAL 0 OR NOT _jolt_changes STREQUAL "")
    message(FATAL_ERROR "Jolt source contains local changes. Restore the pinned source before configuring.")
endif()
# Keep Jolt's broad option names and compiler flags scoped away from core/SDK.
function(_bazzalt_add_jolt)
    set(BUILD_SHARED_LIBS OFF)
    set(OVERRIDE_CXX_FLAGS OFF)
    set(INTERPROCEDURAL_OPTIMIZATION OFF)
    set(USE_STATIC_MSVC_RUNTIME_LIBRARY OFF)
    set(DOUBLE_PRECISION OFF)
    set(CPP_EXCEPTIONS_ENABLED OFF)
    set(CPP_RTTI_ENABLED OFF)
    set(ENABLE_ALL_WARNINGS OFF)
    set(GENERATE_DEBUG_SYMBOLS OFF)
    set(FLOATING_POINT_EXCEPTIONS_ENABLED OFF)
    set(CROSS_PLATFORM_DETERMINISTIC OFF)
    set(OBJECT_LAYER_BITS 16)
    set(ENABLE_OBJECT_STREAM OFF)
    set(ENABLE_INSTALL OFF)
    set(DEBUG_RENDERER_IN_DEBUG_AND_RELEASE OFF)
    set(DEBUG_RENDERER_IN_DISTRIBUTION OFF)
    set(PROFILER_IN_DEBUG_AND_RELEASE OFF)
    set(PROFILER_IN_DISTRIBUTION OFF)
    # Preserve our x86/x64 SSE2 baseline; no accidental AVX-only distribution.
    foreach(feature SSE4_1 SSE4_2 AVX AVX2 AVX512 LZCNT TZCNT F16C FMADD)
        set(USE_${feature} OFF)
    endforeach()
    foreach(application UNIT_TESTS HELLO_WORLD PERFORMANCE_TEST SAMPLES VIEWER)
        set(TARGET_${application} OFF)
    endforeach()
    set(CMAKE_POSITION_INDEPENDENT_CODE ON)
    add_subdirectory("${BAZZALT_JOLT_DIR}/Build" "${CMAKE_BINARY_DIR}/deps/jolt" EXCLUDE_FROM_ALL)
    set_target_properties(Jolt PROPERTIES POSITION_INDEPENDENT_CODE ON)
endfunction()
if(BAZZALT_JOLT_LIBRARY)
    if(NOT EXISTS "${BAZZALT_JOLT_LIBRARY}")
        message(FATAL_ERROR "The supplied prebuilt Jolt library does not exist")
    endif()
    add_library(Jolt STATIC IMPORTED GLOBAL)
    set_target_properties(Jolt PROPERTIES IMPORTED_LOCATION "${BAZZALT_JOLT_LIBRARY}" POSITION_INDEPENDENT_CODE ON INTERFACE_INCLUDE_DIRECTORIES "${BAZZALT_JOLT_DIR}" INTERFACE_COMPILE_DEFINITIONS "JPH_OBJECT_LAYER_BITS=16")
    if(UNIX)
        find_package(Threads REQUIRED)
        set_property(TARGET Jolt APPEND PROPERTY INTERFACE_LINK_LIBRARIES Threads::Threads)
    endif()
else()
    _bazzalt_add_jolt()
endif()
add_library(BazzaltJoltDependency INTERFACE)
add_library(Bazzalt::JoltDependency ALIAS BazzaltJoltDependency)
target_link_libraries(BazzaltJoltDependency INTERFACE Jolt)
message(STATUS "Private Jolt dependency configured for bazzalt_physics")
