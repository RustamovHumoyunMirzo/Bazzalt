include_guard(GLOBAL)
set(BAZZALT_YOJIMBO_DIR "${CMAKE_CURRENT_LIST_DIR}/../deps/yojimbo" CACHE PATH "Pinned private networking sources")
if(NOT EXISTS "${BAZZALT_YOJIMBO_DIR}/include/yojimbo.h")
    message(FATAL_ERROR "Yojimbo is missing. Run scripts/get_yojimbo.ps1 or scripts/get_yojimbo.sh.")
endif()
find_package(Git REQUIRED)
file(READ "${CMAKE_CURRENT_LIST_DIR}/../scripts/dependencies/yojimbo.json" _yojimbo_lock)
string(JSON _yojimbo_commit GET "${_yojimbo_lock}" commit)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${BAZZALT_YOJIMBO_DIR}" rev-parse HEAD OUTPUT_VARIABLE _yojimbo_actual OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _yojimbo_status)
if(NOT _yojimbo_status EQUAL 0 OR NOT _yojimbo_actual STREQUAL _yojimbo_commit)
    message(FATAL_ERROR "Networking source does not match scripts/dependencies/yojimbo.json")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${BAZZALT_YOJIMBO_DIR}" status --porcelain OUTPUT_VARIABLE _yojimbo_changes OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT _yojimbo_changes STREQUAL "")
    message(FATAL_ERROR "Networking source has local changes; restore the pinned dependency before configuring")
endif()
# The upstream amalgamated crypto subset is ~200 KiB, not a full crypto/toolchain build.
add_library(BazzaltCrypto SHARED "${BAZZALT_YOJIMBO_DIR}/sodium/sodium.c")
target_include_directories(BazzaltCrypto PRIVATE "${BAZZALT_YOJIMBO_DIR}/sodium")
target_compile_definitions(BazzaltCrypto PRIVATE SODIUM_STATIC)
set_target_properties(BazzaltCrypto PROPERTIES OUTPUT_NAME bazzalt_crypto WINDOWS_EXPORT_ALL_SYMBOLS ON POSITION_INDEPENDENT_CODE ON
    RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/Editor" LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/Editor" BUILD_RPATH "$ORIGIN" INSTALL_RPATH "$ORIGIN")
if(WIN32)
    target_link_libraries(BazzaltCrypto PRIVATE advapi32)
endif()
file(GLOB _yojimbo_sources CONFIGURE_DEPENDS "${BAZZALT_YOJIMBO_DIR}/source/*.cpp")
add_library(BazzaltYojimbo STATIC ${_yojimbo_sources} "${BAZZALT_YOJIMBO_DIR}/netcode/netcode.c" "${BAZZALT_YOJIMBO_DIR}/reliable/reliable.c" "${BAZZALT_YOJIMBO_DIR}/tlsf/tlsf.c")
target_include_directories(BazzaltYojimbo PUBLIC "${BAZZALT_YOJIMBO_DIR}" "${BAZZALT_YOJIMBO_DIR}/sodium" "${BAZZALT_YOJIMBO_DIR}/include" "${BAZZALT_YOJIMBO_DIR}/serialize" "${BAZZALT_YOJIMBO_DIR}/netcode" "${BAZZALT_YOJIMBO_DIR}/reliable" "${BAZZALT_YOJIMBO_DIR}/tlsf")
target_compile_definitions(BazzaltYojimbo PRIVATE NETCODE_ENABLE_TESTS=0 RELIABLE_ENABLE_TESTS=0)
find_package(Threads REQUIRED)
target_link_libraries(BazzaltYojimbo PUBLIC BazzaltCrypto Threads::Threads)
set_target_properties(BazzaltYojimbo PROPERTIES POSITION_INDEPENDENT_CODE ON)
if(WIN32)
    target_link_libraries(BazzaltYojimbo PUBLIC ws2_32 iphlpapi)
elseif(UNIX)
    target_link_libraries(BazzaltYojimbo PUBLIC m)
endif()
