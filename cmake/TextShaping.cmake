foreach(_dependency harfbuzz sheenbidi)
    if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/deps/${_dependency}/CMakeLists.txt")
        message(FATAL_ERROR "Text shaping dependencies are missing. Run scripts/get_text_shaping.ps1 or .sh.")
    endif()
endforeach()
set(_bazzalt_shaping_shared "${BUILD_SHARED_LIBS}")
set(BUILD_SHARED_LIBS OFF)
foreach(_option HB_BUILD_UTILS HB_BUILD_SUBSET HB_HAVE_CAIRO HB_HAVE_GLIB HB_HAVE_ICU HB_HAVE_GRAPHITE2 HB_HAVE_GOBJECT HB_HAVE_INTROSPECTION HB_HAVE_CORETEXT HB_HAVE_UNISCRIBE HB_HAVE_DIRECTWRITE HB_HAVE_GDI)
    set(${_option} OFF CACHE BOOL "" FORCE)
endforeach()
set(HB_HAVE_FREETYPE ON CACHE BOOL "" FORCE)
add_subdirectory(deps/harfbuzz "${CMAKE_BINARY_DIR}/deps/harfbuzz" EXCLUDE_FROM_ALL)
set(SB_CONFIG_UNITY ON CACHE BOOL "" FORCE)
set(SB_CONFIG_EXPERIMENTAL_TEXT_API OFF CACHE BOOL "" FORCE)
set(BUILD_GENERATOR OFF CACHE BOOL "" FORCE)
add_subdirectory(deps/sheenbidi "${CMAKE_BINARY_DIR}/deps/sheenbidi" EXCLUDE_FROM_ALL)
set(BUILD_SHARED_LIBS "${_bazzalt_shaping_shared}")
set_target_properties(harfbuzz SheenBidi PROPERTIES POSITION_INDEPENDENT_CODE ON)
