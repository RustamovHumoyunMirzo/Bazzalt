material {
 name: BazzaltParticles, shadingModel: unlit, doubleSided: true,
 blending: transparent, depthWrite: false, flipUV: false, requires: [color,uv0],
 parameters: [{type:sampler2d,name:particleTexture},{type:float,name:textured}]
}
fragment {
 void material(inout MaterialInputs material) {
  prepareMaterial(material);
  vec4 color=getColor();
  if(materialParams.textured>0.5) color*=texture(materialParams_particleTexture,getUV0());
  else color.a*=1.0-smoothstep(0.35,0.5,length(getUV0()-vec2(0.5)));
  if(color.a<0.001) discard;
  material.baseColor=color;
 }
}
