material {
    name : BazzaltVignette,
    domain : postprocess,
    parameters : [
        { type : sampler2d, name : source },
        { type : float4, name : color },
        { type : float, name : intensity },
        { type : float, name : smoothness },
        { type : float, name : roundness }
    ],
    outputs : [ { type : float4, name : color, precision : high } ],
    variables : [ vertex ],
    depthWrite : false,
    depthCulling : false
}

vertex {
    void postProcessVertex(inout PostProcessVertexInputs postProcess) {
        postProcess.vertex.xy = uvToRenderTargetUV(postProcess.normalizedUV);
    }
}

fragment {
    void postProcess(inout PostProcessInputs postProcess) {
        highp vec2 uv = variable_vertex.xy;
        vec4 sourceColor = texture(materialParams_source, uv);
        highp vec2 centered = abs(uv * 2.0 - 1.0);
        centered.x *= mix(1.0, 0.5, clamp(materialParams.roundness, 0.0, 1.0));
        float edge = length(centered);
        float softness = max(materialParams.smoothness, 0.0001);
        float mask = smoothstep(1.0 - softness, 1.0, edge);
        mask *= clamp(materialParams.intensity, 0.0, 1.0);
        postProcess.color = mix(sourceColor, materialParams.color, mask * materialParams.color.a);
    }
}
