material {
    name : BazzaltTerrain,
    shadingModel : lit,
    doubleSided : true,
    parameters : [ { type : sampler2d, name : bazzaltLightingData, precision : high }, { type : float, name : bazzaltLightingEnabled }, { type : float4, name : bazzaltLodFade }, { type : float4, name : baseColor }, { type : float, name : showGrid } ],
    requires : [ tangents, uv0, uv1, color ]
}
fragment {
#include "baked_lighting.glsl"
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        if (materialParams.bazzaltLodFade.z > 0.5) {
            ivec2 p = ivec2(floor(getNormalizedViewportCoord().xy * getResolution().xy)) & 7;
            int n = 0;
            for (int b = 0; b < 3; ++b) {
                int x = (p.x >> b) & 1; int y = (p.y >> b) & 1;
                n |= ((x ^ y) * 2 + y) << (2 * (2 - b));
            }
            float threshold = (float(n) + 0.5) / 64.0;
            if (threshold < materialParams.bazzaltLodFade.x || threshold >= materialParams.bazzaltLodFade.y) discard;
        }

        material.baseColor = materialParams.baseColor * getColor();
        vec2 coord = getUV0();
        vec2 edge = abs(fract(coord - 0.5) - 0.5) / max(fwidth(coord), vec2(0.0001));
        float grid = 1.0 - min(min(edge.x, edge.y), 1.0);
        material.baseColor.rgb *= 1.0 - grid * 0.22 * materialParams.showGrid;
        material.roughness = 0.72;
        material.metallic = 0.0;
        bazzaltApplyDiffuse(material);
    }
#include "baked_reflections.glsl"
}
