material {
    name : BazzaltGaussianBlur,
    domain : postprocess,
    parameters : [
        { type : sampler2d, name : source },
        { type : float2, name : texelSize },
        { type : float, name : blurSize }
    ],
    outputs : [ { type : float4, name : color, precision : high } ],
    variables : [ vertex ],
    depthWrite : false,
    depthCulling : false
}

vertex {
    void postProcessVertex(inout PostProcessVertexInputs postProcess) {
        postProcess.vertex.xy = uvToRenderTargetUV(postProcess.normalizedUV);
    }
}

fragment {
    void postProcess(inout PostProcessInputs postProcess) {
        highp vec2 uv = variable_vertex.xy;
        highp vec2 stepSize = materialParams.texelSize * max(materialParams.blurSize, 0.0);
        vec4 color = texture(materialParams_source, uv) * 0.25;
        color += texture(materialParams_source, uv + vec2(stepSize.x, 0.0)) * 0.125;
        color += texture(materialParams_source, uv - vec2(stepSize.x, 0.0)) * 0.125;
        color += texture(materialParams_source, uv + vec2(0.0, stepSize.y)) * 0.125;
        color += texture(materialParams_source, uv - vec2(0.0, stepSize.y)) * 0.125;
        color += texture(materialParams_source, uv + stepSize) * 0.0625;
        color += texture(materialParams_source, uv - stepSize) * 0.0625;
        color += texture(materialParams_source, uv + vec2(stepSize.x, -stepSize.y)) * 0.0625;
        color += texture(materialParams_source, uv + vec2(-stepSize.x, stepSize.y)) * 0.0625;
        postProcess.color = color;
    }
}
