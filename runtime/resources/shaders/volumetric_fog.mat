material {
    name: BazzaltVolumetricFog,
    shadingModel: unlit,
    blending: transparent,
    vertexDomain: device,
    depthWrite: false,
    depthCulling: false,
    doubleSided: true,
    parameters: [{type:float4,name:atlasInfo,precision:high},{type:float4,name:gridInfo,precision:high},{type:float4,name:fogInfo,precision:high},
        {type:float4x4,name:inverseProjection,precision:high},{type:float4,name:cameraInfo,precision:high},
        {type:sampler2d,name:sceneColor,precision:high},{type:sampler2d,name:sceneDepth,precision:high},
        {type:sampler2d,name:medium,precision:high},{type:sampler2d,name:integrated,precision:high}]
}
fragment {
    highp vec2 volumeUV(highp vec2 uv, int slice) {
        highp vec2 size=materialParams.gridInfo.xy;
        highp vec2 cell=clamp(uv*size,vec2(0.5),size-vec2(0.5));
        highp vec2 tile=vec2(float(slice%8),float(slice/8));
        return uvToRenderTargetUV((tile*size+cell)/(size*materialParams.atlasInfo.xy));
    }
    highp float boundary(int index) {
        highp float t=float(index)/materialParams.gridInfo.z;
        return materialParams.gridInfo.w*t*t;
    }
    // Antiderivative of smoothstep(start,start+width,z). Integrating the
    // fade analytically prevents pre-start leakage and slice-boundary popping.
    highp float mediumDistance(highp float z) {
        highp float start=materialParams.fogInfo.y;
        if(start<=0.0)return z;
        highp float width=max(1.0,min(5.0,start*0.5));
        highp float t=clamp((z-start)/width,0.0,1.0);
        return width*(t*t*t-0.5*t*t*t*t)+max(0.0,z-start-width);
    }
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        highp vec2 uv=getNormalizedViewportCoord().xy;
        highp vec4 source=texture(materialParams_sceneColor,uvToRenderTargetUV(uv));
        highp float depth=texture(materialParams_sceneDepth,uvToRenderTargetUV(uv)).r;
        if(materialParams.fogInfo.x<=0.0||materialParams.fogInfo.w<=0.0||(depth<=0.0000001&&materialParams.cameraInfo.w<0.5)){material.baseColor=source;return;}
        highp vec4 nearPoint=materialParams.inverseProjection*vec4(uv*2.0-1.0,-1.0,1.0);
        highp float forward=materialParams.cameraInfo.z>0.5 ? 1.0 : max(-normalize(nearPoint.xyz/nearPoint.w).z,0.00001);
        highp float z=materialParams.fogInfo.z;
        if(depth>0.0000001){
            highp vec4 p=materialParams.inverseProjection*vec4(uv*2.0-1.0,1.0-2.0*depth,1.0);
            z=materialParams.cameraInfo.z>0.5 ? nearPoint.z/nearPoint.w-p.z/p.w : -p.z/p.w;
        }
        z=clamp(z,0.0,materialParams.fogInfo.z);
        int slice=min(int(materialParams.gridInfo.z)-1,int(sqrt(z/materialParams.fogInfo.z)*materialParams.gridInfo.z));
        highp vec4 fog=vec4(0,0,0,1);
        if(slice>0)fog=texture(materialParams_integrated,volumeUV(uv,slice-1));
        highp vec4 medium=texture(materialParams_medium,volumeUV(uv,slice));
        highp float ds=max(0.0,mediumDistance(z)-mediumDistance(boundary(slice)))/forward;
        highp float segmentT=exp(-max(medium.a,0.0)*ds);
        highp float integral=medium.a>0.000001 ? (1.0-segmentT)/medium.a : ds;
        fog.rgb+=fog.a*medium.rgb*integral;fog.a*=segmentT;
        highp float weight=min(1.0,(materialParams.fogInfo.w/max(0.000001,1.0-fog.a)));
        material.baseColor=vec4(source.rgb*(1.0-weight*(1.0-fog.a))+source.a*fog.rgb*weight,source.a);
    }
}
