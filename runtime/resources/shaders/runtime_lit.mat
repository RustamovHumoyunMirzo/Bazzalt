material {
    name : BazzaltRuntimeLit,
    shadingModel : lit,
    doubleSided : true,
    blending : opaque,
    
    parameters : [ { type : sampler2d, name : bazzaltLightingData, precision : high }, { type : float, name : bazzaltLightingEnabled }, { type : float4, name : bazzaltLodFade },
        { type : float4, name : baseColor },
        { type : float3, name : emissive },
        { type : float, name : roughness },
        { type : float, name : metallic },
        { type : float, name : reflectance }
    ],
    requires : [ tangents ]
}
fragment {
#include "baked_lighting.glsl"
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        if (materialParams.bazzaltLodFade.z > 0.5) {
            ivec2 p = ivec2(floor(getNormalizedViewportCoord().xy * getResolution().xy)) & 7;
            int n = 0;
            for (int b = 0; b < 3; ++b) {
                int x = (p.x >> b) & 1; int y = (p.y >> b) & 1;
                n |= ((x ^ y) * 2 + y) << (2 * (2 - b));
            }
            float threshold = (float(n) + 0.5) / 64.0;
            if (threshold < materialParams.bazzaltLodFade.x || threshold >= materialParams.bazzaltLodFade.y) discard;
        }

        material.baseColor = materialParams.baseColor;
        material.emissive = vec4(materialParams.emissive, 0.0);
        material.roughness = clamp(materialParams.roughness, 0.0, 1.0);
        material.metallic = clamp(materialParams.metallic, 0.0, 1.0);
        material.reflectance = clamp(materialParams.reflectance, 0.0, 1.0);
        bazzaltApplyDiffuse(material);
    }
#include "baked_reflections.glsl"
}
