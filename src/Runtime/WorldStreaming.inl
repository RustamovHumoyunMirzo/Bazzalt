// Included in StreamingRuntime.cpp; no worker may touch these host-thread structures.
namespace {
bool Finite(Vec3 v){return std::isfinite(v.X)&&std::isfinite(v.Y)&&std::isfinite(v.Z);}
bool ValidCell(const StreamingCell& c){return c.SceneAsset&&Finite(c.Offset.Position)&&Finite(c.Offset.Scale)&&c.Offset.Scale.X!=0&&c.Offset.Scale.Y!=0&&c.Offset.Scale.Z!=0&&std::isfinite(c.Offset.Rotation.X)&&std::isfinite(c.Offset.Rotation.Y)&&std::isfinite(c.Offset.Rotation.Z)&&std::isfinite(c.Offset.Rotation.W)&&c.Offset.Rotation.LengthSquared()>Epsilon&&Finite(c.HalfExtents)&&c.HalfExtents.X>=0&&c.HalfExtents.Y>=0&&c.HalfExtents.Z>=0&&std::isfinite(c.LoadDistance)&&std::isfinite(c.UnloadDistance)&&c.LoadDistance>=0&&c.UnloadDistance>c.LoadDistance;}
bool ValidGrid(const StreamingGrid& grid){if(!Finite(grid.Origin)||!Finite(grid.CellSize)||grid.CellSize.X<=0||grid.CellSize.Y<=0||grid.CellSize.Z<=0||grid.Cells.empty()||grid.Cells.size()>4096||!std::isfinite(grid.LoadDistance)||!std::isfinite(grid.UnloadDistance)||grid.LoadDistance<0||grid.UnloadDistance<=grid.LoadDistance)return false;std::set<UUID> ids;std::set<std::tuple<int,int,int>> coordinates;for(auto& c:grid.Cells){if(!c.SceneAsset||!ids.insert(c.SceneAsset).second||!coordinates.emplace(c.X,c.Y,c.Z).second)return false;for(double p:{double(grid.Origin.X)+double(c.X)*grid.CellSize.X,double(grid.Origin.Y)+double(c.Y)*grid.CellSize.Y,double(grid.Origin.Z)+double(c.Z)*grid.CellSize.Z})if(!std::isfinite(p)||std::abs(p)>std::numeric_limits<float>::max())return false;}return true;}
}
void StreamingRuntime::Impl::Publish(Cell& cell){if(!cell.Additive||cell.Prefab)return;auto status=cell.State->Status.load();if(cell.Reported&&cell.LastReported==status)return;cell.Reported=true;cell.LastReported=status;std::string error;{std::lock_guard lock(cell.State->Mutex);error=cell.State->Error;}if(Events.size()<4096)Events.push_back({cell.Asset,cell.State->Root,status,error});if(status==AsyncLoadStatus::Failed){RetryAfter[cell.Asset]=std::chrono::steady_clock::now()+std::chrono::duration_cast<std::chrono::steady_clock::duration>(std::chrono::duration<float>(Settings.RetryDelaySeconds));if(!error.empty())Console::Error(error,"Streaming");}}
bool StreamingRuntime::Impl::Drain(Cell& cell,std::size_t& remaining,std::chrono::steady_clock::time_point deadline){auto& state=*cell.State;if(!cell.UnloadStarted){cell.UnloadStarted=true;state.Cancelled=true;state.Status=AsyncLoadStatus::Unloading;Publish(cell);Stop(cell);}if(!cell.Additive||cell.Prefab){cell.Owned.clear();cell.Staging.reset();{std::lock_guard lock(state.Mutex);state.Prepared.reset();state.Memory.reset();}state.Status=!cell.Failure.empty()?AsyncLoadStatus::Failed:cell.Unload?AsyncLoadStatus::Unloaded:AsyncLoadStatus::Cancelled;return true;}auto& scene=Host.GetScene();while(!cell.Owned.empty()&&remaining&&std::chrono::steady_clock::now()<deadline){auto id=cell.Owned.back();cell.Owned.pop_back();if(auto entity=scene.GetEntity(id)){for(auto child:entity.GetChildren())scene.RemoveParent(child,true);scene.DestroyEntity(entity);}--remaining;}if(!cell.Owned.empty()||!remaining||std::chrono::steady_clock::now()>=deadline)return false;if(auto root=scene.GetEntity(state.Root)){for(auto child:root.GetChildren())scene.RemoveParent(child,true);scene.DestroyEntity(root);--remaining;}cell.Staging.reset();{std::lock_guard lock(state.Mutex);state.Prepared.reset();state.Memory.reset();}state.Progress=1;state.Status=!cell.Failure.empty()?AsyncLoadStatus::Failed:cell.Unload?AsyncLoadStatus::Unloaded:AsyncLoadStatus::Cancelled;return true;}
void StreamingRuntime::Impl::SynchronizeDefinitions(){Definitions=Registered;CurrentSources.clear();if(HasPosition)CurrentSources.push_back({Position,1});for(auto& [_,source]:Sources)CurrentSources.push_back(source);if(!Host.m_scriptsRunning)return;auto& scene=Host.GetScene();std::unordered_map<UUID,AsyncLoadStatus> roots;for(auto& cell:Cells)if(cell->Additive&&cell->State->Root)roots[cell->State->Root]=cell->State->Status.load();auto active=[&](Entity entity){for(auto p=entity;p&&!p.GetUUID().IsRoot();p=p.GetParent())if(auto it=roots.find(p.GetUUID());it!=roots.end()&&it->second!=AsyncLoadStatus::Complete)return false;return true;};
 for(auto handle:scene.GetRegistry().view<StreamingSource>()){auto entity=scene.GetEntity(static_cast<Entity::Id>(handle));auto& source=entity.GetComponent<StreamingSource>();if(source.Enabled&&source.IsValid()&&active(entity)){auto position=entity.GetWorldMatrix().TransformPoint({});if(Finite(position))CurrentSources.push_back({position,source.DistanceScale});}}
 std::unordered_map<UUID,unsigned> counts;for(auto handle:scene.GetRegistry().view<WorldCell>()){auto e=scene.GetEntity(static_cast<Entity::Id>(handle));auto& c=e.GetComponent<WorldCell>();if(c.Enabled&&c.SceneAsset&&active(e))++counts[c.SceneAsset];}
 for(auto handle:scene.GetRegistry().view<WorldCell>()){auto entity=scene.GetEntity(static_cast<Entity::Id>(handle));auto& value=entity.GetComponent<WorldCell>();if(!value.Enabled||!value.SceneAsset||!active(entity))continue;StreamingCell cell;cell.SceneAsset=value.SceneAsset;cell.Offset=entity.GetWorldTransform();cell.LoadDistance=value.LoadDistance;cell.UnloadDistance=value.UnloadDistance;cell.Priority=value.Priority;cell.AlwaysLoaded=value.AlwaysLoaded;auto matrix=entity.GetWorldMatrix();auto h=value.HalfExtents;cell.HalfExtents={std::abs(matrix(0,0))*h.X+std::abs(matrix(0,1))*h.Y+std::abs(matrix(0,2))*h.Z,std::abs(matrix(1,0))*h.X+std::abs(matrix(1,1))*h.Y+std::abs(matrix(1,2))*h.Z,std::abs(matrix(2,0))*h.X+std::abs(matrix(2,1))*h.Y+std::abs(matrix(2,2))*h.Z};if(!value.IsValid()||!ValidCell(cell)||counts[cell.SceneAsset]!=1||Definitions.contains(cell.SceneAsset)||Definitions.size()>=4096){if(InvalidDefinitions.insert(entity.GetUUID()).second)Console::Error("Invalid or duplicate World Cell definition: "+entity.GetUUID().ToString(),"Streaming");continue;}InvalidDefinitions.erase(entity.GetUUID());Definitions.emplace(cell.SceneAsset,std::move(cell));}
 std::erase_if(InvalidDefinitions,[&](UUID id){return !scene.GetEntity(id);});
}
float StreamingRuntime::Impl::Distance(const StreamingCell& cell)const{double nearest=std::numeric_limits<float>::max();for(auto& source:CurrentSources){double dx=std::max(0.,std::abs(double(source.Position.X)-cell.Offset.Position.X)-cell.HalfExtents.X),dy=std::max(0.,std::abs(double(source.Position.Y)-cell.Offset.Position.Y)-cell.HalfExtents.Y),dz=std::max(0.,std::abs(double(source.Position.Z)-cell.Offset.Position.Z)-cell.HalfExtents.Z);nearest=std::min(nearest,std::sqrt(dx*dx+dy*dy+dz*dz)/source.Scale);}return float(std::min(nearest,double(std::numeric_limits<float>::max())));}
void StreamingRuntime::Impl::EvaluateCells(StreamingRuntime& runtime){for(auto& cell:Cells)if(cell->Additive&&!cell->Prefab&&!cell->Unload&&cell->State->Status==AsyncLoadStatus::Complete){auto definition=Definitions.find(cell->Asset);if(definition!=Definitions.end()&&cell->Offset.GetMatrix().Values!=definition->second.Offset.GetMatrix().Values)if(auto root=Host.GetScene().GetEntity(cell->State->Root)){if(root.SetWorldTransform(definition->second.Offset))cell->Offset=definition->second.Offset;}}auto now=std::chrono::steady_clock::now();for(auto it=Automatic.begin();it!=Automatic.end();){auto definition=Definitions.find(it->first);auto status=it->second.GetStatus();bool remove=definition==Definitions.end()||(!definition->second.AlwaysLoaded&&Distance(definition->second)>definition->second.UnloadDistance);if(remove){runtime.UnloadCell(it->first);it=Automatic.erase(it);}else if(status==AsyncLoadStatus::Unloaded||status==AsyncLoadStatus::Cancelled||(status==AsyncLoadStatus::Failed&&RetryAfter.contains(it->first)&&now>=RetryAfter.at(it->first)))it=Automatic.erase(it);else ++it;}
 std::vector<std::tuple<double,double,UUID>> order;for(auto& [id,cell]:Definitions)if(!Automatic.contains(id)&&(cell.AlwaysLoaded||Distance(cell)<=cell.LoadDistance))order.emplace_back(-double(cell.Priority),Distance(cell),id);std::sort(order.begin(),order.end());std::uint32_t requested=0;for(auto [priority,distance,id]:order){if(requested>=Settings.MaxConcurrentLoads)break;if(Pending()>=Settings.MaxPendingLoads||ResidentSlots()>=Settings.MaxResidentCells)break;if(RetryAfter.contains(id)&&now<RetryAfter.at(id))continue;bool draining=false;for(auto& cell:Cells)if(cell->Asset==id&&(cell->Unload||cell->UnloadStarted)){draining=true;break;}if(draining)continue;auto& cell=Definitions.at(id);auto handle=runtime.RequestScene(id,true,true,cell.Offset);++requested;Automatic.emplace(id,handle);if(handle.GetStatus()==AsyncLoadStatus::Failed){RetryAfter[id]=now+std::chrono::duration_cast<std::chrono::steady_clock::duration>(std::chrono::duration<float>(Settings.RetryDelaySeconds));if(Events.size()<4096)Events.push_back({id,{},AsyncLoadStatus::Failed,handle.GetError()});Console::Error(handle.GetError(),"Streaming");}}
 std::erase_if(LastStates,[&](const auto& row){if(Definitions.contains(row.first)||Automatic.contains(row.first))return false;for(auto& cell:Cells)if(cell->Asset==row.first)return false;RetryAfter.erase(row.first);return true;});
}
void StreamingRuntime::ClearPosition(){m_impl->HasPosition=false;}
void StreamingRuntime::SetSource(UUID id,Vec3 position,float scale){if(!id||!Finite(position)||!std::isfinite(scale)||scale<=0||scale>1000)throw std::invalid_argument("Invalid streaming source");if(!m_impl->Sources.contains(id)&&m_impl->Sources.size()>=256)throw std::length_error("Too many streaming sources");m_impl->Sources[id]={position,scale};}
bool StreamingRuntime::RemoveSource(UUID id){return m_impl->Sources.erase(id)!=0;}
bool StreamingRuntime::RegisterGrid(const StreamingGrid& grid){if(!ValidGrid(grid)||m_impl->Resetting||grid.Cells.size()>4096-m_impl->Registered.size())return false;for(auto& entry:grid.Cells){auto asset=m_impl->Host.FindAsset(entry.SceneAsset);if(m_impl->Registered.contains(entry.SceneAsset)||!asset||asset->State!=AssetState::Ready||asset->SourcePath.extension()!=".bscene")return false;}for(auto& entry:grid.Cells){StreamingCell cell;cell.SceneAsset=entry.SceneAsset;cell.Offset.Position={float(double(grid.Origin.X)+double(entry.X)*grid.CellSize.X),float(double(grid.Origin.Y)+double(entry.Y)*grid.CellSize.Y),float(double(grid.Origin.Z)+double(entry.Z)*grid.CellSize.Z)};cell.HalfExtents=grid.CellSize*.5f;cell.LoadDistance=grid.LoadDistance;cell.UnloadDistance=grid.UnloadDistance;m_impl->Registered.emplace(cell.SceneAsset,cell);}return true;}
bool StreamingRuntime::RetryCell(UUID id){auto it=m_impl->Automatic.find(id);if(it==m_impl->Automatic.end()||it->second.GetStatus()!=AsyncLoadStatus::Failed)return false;m_impl->Automatic.erase(it);m_impl->RetryAfter.erase(id);return true;}
std::vector<StreamingEvent> StreamingRuntime::GetEvents()const{return m_impl->Events;}
std::vector<StreamingCellInfo> StreamingRuntime::GetCells()const{auto& impl=*m_impl;auto definitions=impl.Definitions;for(auto& [id,cell]:impl.Registered)definitions[id]=cell;std::map<UUID,StreamingCellInfo> rows;for(auto& [id,definition]:definitions){auto& row=rows[id];row.SceneAsset=id;row.Automatic=true;row.Distance=impl.Distance(definition);if(auto it=impl.LastStates.find(id);it!=impl.LastStates.end()){SceneLoadHandle h(it->second);row.Status=h.GetStatus();row.RootUUID=h.GetRootUUID();row.SceneUUID=h.GetSceneUUID();row.Progress=h.GetProgress();row.Error=h.GetError();}}for(auto& cell:impl.Cells)if(cell->Additive&&!cell->Prefab){auto& row=rows[cell->Asset];row.SceneAsset=cell->Asset;SceneLoadHandle h(cell->State);row.Status=h.GetStatus();row.RootUUID=h.GetRootUUID();row.SceneUUID=h.GetSceneUUID();row.Progress=h.GetProgress();row.Error=h.GetError();}std::vector<StreamingCellInfo> out;for(auto& [_,row]:rows)out.push_back(std::move(row));return out;}
StreamingStatistics StreamingRuntime::GetStatistics()const{StreamingStatistics stats;stats.RegisteredCells=std::uint32_t(std::max(m_impl->Definitions.size(),m_impl->Registered.size()));stats.PendingLoads=std::uint32_t(m_impl->Pending());stats.Sources=std::uint32_t(m_impl->CurrentSources.size());stats.ResourceBytes=m_impl->Memory->Used.load();for(auto& cell:m_impl->Cells)if(cell->Additive&&!cell->Prefab){if(cell->State->Status==AsyncLoadStatus::Complete)++stats.ResidentCells;else if(cell->State->Status==AsyncLoadStatus::Unloading)++stats.UnloadingCells;}return stats;}
